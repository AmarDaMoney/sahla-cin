# Copier ce fichier en .env et remplir avec les valeurs de VOTRE projet Supabase
# (Supabase Dashboard → Project Settings → API).

# Côté navigateur (exposées publiquement, c'est normal : la sécurité repose sur RLS)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Côté serveur (fonctions serveur / SSR)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET — ne jamais préfixer par VITE_ ni committer. Sert à confirmer les paiements.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# "simulation" : les paiements en ligne sont acceptés immédiatement (démo / tests).
# Laisser vide en production tant qu'aucun prestataire de paiement n'est branché :
# seul le paiement au guichet sera proposé.
PAYMENT_MODE="simulation"
