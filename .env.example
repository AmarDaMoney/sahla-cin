# Copier en .env pour le développement local. Sur Railway : onglet « Variables »
# du service (les valeurs ci-dessous sont des exemples).

# Base de données PostgreSQL. Sur Railway : ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgres://postgres:postgres@localhost:5432/sahla"

# Adresse publique de l'application. Sur Railway, facultatif si le service a
# un domaine (RAILWAY_PUBLIC_DOMAIN est utilisé automatiquement). Sert aux liens des e-mails
# et à la protection contre les requêtes d'autres sites.
BETTER_AUTH_URL="http://localhost:8080"
# Secret de signature des sessions : 32+ caractères aléatoires.
#   Générer : openssl rand -base64 32
BETTER_AUTH_SECRET="changez-moi-avec-openssl-rand-base64-32"

# Comptes administrateurs (adresses vérifiées, séparées par des virgules).
ADMIN_EMAILS="vous@exemple.com"

# E-mails (confirmation d'adresse, mot de passe oublié, billets) via resend.com.
# Sans clé : les e-mails ne partent pas, leur contenu (et le lien) est écrit
# dans les logs. Indispensable avant d'ouvrir le site au public.
RESEND_API_KEY=""
EMAIL_FROM="BookCinéDZ <billets@votre-domaine.dz>"

# Connexion Google (facultatif) — console.cloud.google.com → Identifiants OAuth.
# URI de redirection autorisée : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Import des fiches films depuis The Movie Database (facultatif) : clé API
# gratuite sur themoviedb.org → Paramètres → API (clé v3 ou jeton v4).
TMDB_API_KEY=""

# "simulation" : paiements en ligne acceptés immédiatement (démo / tests).
# Vide : seul le paiement au guichet est proposé (tant qu'aucun prestataire réel
# n'est branché).
PAYMENT_MODE="simulation"

# En-tête contenant l'IP réelle du visiteur (limitation des tentatives de connexion).
CLIENT_IP_HEADER="x-real-ip"

# Numéro WhatsApp du support, format international sans « + » (facultatif).
VITE_WHATSAPP_NUMBER=""
